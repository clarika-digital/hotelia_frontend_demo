NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# API mode: "test" runs the in-memory mock engine; "dev" and "prod" call the real
# backend at NEXT_PUBLIC_API_URL (dev points at a dev DB, prod at the production DB)
NEXT_PUBLIC_API_MODE=test
NEXT_PUBLIC_SITE_URL=http://localhost:3000
